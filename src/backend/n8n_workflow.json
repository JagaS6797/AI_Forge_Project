        {
            "parameters": {
                "jsCode": "// Classify message intent using keywords\nconst message = ($json.user_message || \u0027\u0027).toLowerCase();\nlet intent = \u0027normal\u0027;\n\n// Escalation keywords\nconst escalationKeywords = [\u0027urgent\u0027, \u0027broken\u0027, \u0027error\u0027, \u0027not working\u0027, \u0027bug\u0027, \u0027issue\u0027, \u0027problem\u0027, \u0027failed\u0027, \u0027help\u0027, \u0027support\u0027, \u0027critical\u0027, \u0027down\u0027, \u0027emergency\u0027];\nif (escalationKeywords.some(kw =\u003e message.includes(kw))) {\n  intent = \u0027escalation\u0027;\n}\n\n// Compliance keywords\nconst complianceKeywords = [\u0027lawsuit\u0027, \u0027legal\u0027, \u0027gdpr\u0027, \u0027privacy\u0027, \u0027breach\u0027, \u0027security\u0027, \u0027vulnerable\u0027];\nif (complianceKeywords.some(kw =\u003e message.includes(kw))) {\n  intent = \u0027compliance\u0027;\n}\n\n// Sales keywords\nconst salesKeywords = [\u0027price\u0027, \u0027pricing\u0027, \u0027buy\u0027, \u0027purchase\u0027, \u0027plan\u0027, \u0027upgrade\u0027, \u0027enterprise\u0027, \u0027cost\u0027, \u0027trial\u0027, \u0027demo\u0027, \u0027sales\u0027, \u0027subscription\u0027];\nif (salesKeywords.some(kw =\u003e message.includes(kw))) {\n  intent = \u0027sales\u0027;\n}\n\nreturn [{\n  json: {\n    ...($json),\n    intent: intent,\n    priority: intent === \u0027compliance\u0027 ? \u0027URGENT\u0027 : (intent === \u0027escalation\u0027 ? \u0027HIGH\u0027 : (intent === \u0027sales\u0027 ? \u0027MEDIUM\u0027 : \u0027LOW\u0027))\n  }\n}];"
            },
            "id": "628afbfb-1eda-44f1-992f-dc0d759d3387",
            "name": "3. Classify Intent (Keyword)",
            "type": "n8n-nodes-base.code",
